{
  "name": "lingoflow",
  "description": "A lightweight bilingual translation Chrome extension.",
  "version": "2.0.4",
  "license": "GPL-3.0-only",
  "author": "Gabe<yugang2002@gmail.com>",
  "private": true,
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.15",
    "@mui/lab": "5.0.0-alpha.170",
    "@mui/material": "^5.15.15",
    "@streamparser/json": "^0.0.22",
    "dompurify": "^3.4.17",
    "query-string": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^7.18.5",
    "sval": "^0.5.2",
    "webextension-polyfill": "^0.10.0"
  },
  "scripts": {
    "start": "pnpm sync:design && cross-env REACT_APP_CLIENT=chrome react-app-rewired start",
    "sync-version": "node src/scripts/sync-version.mjs",
    "check:standard": "node src/scripts/sync-version.mjs --check && pnpm check:design",
    "verify:package": "node src/scripts/verify-release.mjs",
    "test:release": "cross-env CI=true react-app-rewired test --watchAll=false --runInBand --silent --runTestsByPath src/libs/translator.test.js src/providers/translation.translate.test.js src/libs/rules.test.js src/libs/storage.test.js src/libs/dnrRules.test.js src/core/dom/layout.test.js src/core/scanner/DomScanner.test.js src/core/renderer/TranslationRenderer.test.js src/core/renderer/repairTranslationLayout.test.js",
    "test:chrome": "node src/scripts/chrome-smoke.mjs",
    "verify:dev": "node src/scripts/release-preflight.mjs --mode=development && pnpm check:standard && pnpm test:release && pnpm build+zip && node src/scripts/chrome-smoke.mjs",
    "verify:release": "node src/scripts/release-preflight.mjs --mode=release && pnpm check:standard && pnpm test:release && pnpm build+zip && node src/scripts/chrome-smoke.mjs && node src/scripts/release-preflight.mjs --mode=release",
    "version:patch": "zx src/scripts/update-version.mjs patch",
    "version:minor": "zx src/scripts/update-version.mjs minor",
    "version:major": "zx src/scripts/update-version.mjs major",
    "version:set": "zx src/scripts/update-version.mjs set",
    "build:chrome": "zx src/scripts/build-task.mjs --target=chrome",
    "format": "prettier --write \"**/*.{js,json,html}\"",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "i18n:report": "node src/scripts/dynamic-i18n-report.mjs",
    "test:ci": "cross-env CI=true react-app-rewired test --watchAll=false --runInBand",
    "bench:stream": "cross-env LINGOFLOW_BENCH_PHASE=after pnpm test:ci --runTestsByPath src/scripts/stream-baseline.test.js --silent",
    "build": "pnpm sync-version && pnpm sync:design && pnpm build:chrome",
    "zip": "zx src/scripts/archive.mjs && pnpm verify:package",
    "build+zip": "cross-env CI=true pnpm build && pnpm zip",
    "test": "react-app-rewired test",
    "test:subtitle-segmentation": "babel-node src/scripts/test-subtitle-segmentation.js",
    "eject": "react-scripts eject",
    "sync:design": "node src/scripts/design-tokens.mjs",
    "check:design": "node src/scripts/design-tokens.mjs --check"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/**/*.test.js",
          "src/**/*.test.jsx",
          "src/**/*.test.tsx"
        ],
        "rules": {
          "testing-library/no-container": "off",
          "testing-library/render-result-naming-convention": "off",
          "testing-library/no-unnecessary-act": "off",
          "require-yield": "off",
          "no-useless-constructor": "off"
        }
      }
    ],
    "globals": {
      "globalThis": true,
      "LanguageDetector": true,
      "Translator": true
    }
  },
  "browserslist": {
    "production": [
      "last 2 chrome versions"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.22.20",
    "@babel/node": "^7.22.19",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.22.20",
    "@types/chrome": "^0.2.5",
    "@types/jest": "^27.5.2",
    "@types/node": "^18.19.130",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "bestzip": "^2.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.1",
    "find-up": "^7.0.0",
    "prettier": "3.6.2",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "5.0.1",
    "typescript": "^5.9.3",
    "zx": "^8.8.1"
  }
}
